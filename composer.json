{
  "name": "webconsulting/visual-editor-enhancements",
  "type": "typo3-cms-extension",
  "description": "Visual Editor enhancements: element library, editable link helper, select/category field chooser, and editor UI bridges.",
  "keywords": [
    "TYPO3",
    "visual-editor",
    "frontend-editing",
    "content-elements"
  ],
  "homepage": "https://webconsulting.at",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "webconsulting GmbH",
      "email": "office@webconsulting.at",
      "homepage": "https://webconsulting.at"
    }
  ],
  "support": {
    "issues": "https://github.com/dirnbauer/typo3-visual-editor-enhancements/issues",
    "source": "https://github.com/dirnbauer/typo3-visual-editor-enhancements"
  },
  "require": {
    "php": "^8.4",
    "friendsoftypo3/visual-editor": "^1.10.2",
    "typo3/cms-backend": "^14.3.7",
    "typo3/cms-core": "^14.3.7",
    "typo3/cms-fluid": "^14.3.7",
    "typo3/cms-frontend": "^14.3.7"
  },
  "require-dev": {
    "friendsoftypo3/content-blocks": "^2.4.10",
    "phpstan/phpstan": "^2.2",
    "phpstan/phpstan-phpunit": "^2.0.18",
    "phpunit/phpunit": "^13.3",
    "saschaegerer/phpstan-typo3": "^3.1",
    "typo3/coding-standards": "^0.9",
    "typo3/testing-framework": "^9.7"
  },
  "autoload": {
    "psr-4": {
      "Webconsulting\\VisualEditorEnhancements\\": "Classes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Webconsulting\\VisualEditorEnhancements\\Tests\\": "Tests/"
    }
  },
  "scripts": {
    "cgl": "php-cs-fixer fix --config .php-cs-fixer.dist.php",
    "cgl:check": "@cgl --dry-run --diff",
    "lint:php": "find Classes Configuration Tests ext_localconf.php -name '*.php' -print0 | xargs -0 -n1 -P4 php -l",
    "phpstan": "phpstan analyse --memory-limit=512M",
    "test": ["@test:unit", "@test:js"],
    "test:functional": "phpunit -c Build/phpunit/FunctionalTests.xml",
    "test:js": "node --test 'Tests/JavaScript/*.test.js'",
    "test:unit": "phpunit -c Build/phpunit/UnitTests.xml"
  },
  "config": {
    "allow-plugins": {
      "typo3/class-alias-loader": true,
      "typo3/cms-composer-installers": true
    },
    "sort-packages": true
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "visual_editor_enhancements",
      "web-dir": ".Build/Web"
    }
  }
}
